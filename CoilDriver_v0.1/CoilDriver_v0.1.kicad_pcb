		)
	)
	(gr_text "CoilDriver_v0.1\nThree current outputs, 3A Max each\nTakes an external 15V supply (~10A rated is OK) via front connector\n\nDigital Decoder from DDS9959V11 and DAC implemented to set three separate current setpoints\nOnly allows adjusting one setpoint at a time. While doing so ALL DIR bits must be driven to the desired value\nSetpoints will be kept by the DAC after adjusting it\n\nJumper J3 allows choosing the source to drive current and to power the H-bridge MOSFETs\nConnecting the middle FOUR pins chooses the external +15V supply\nConnecting 1 and 6 (LEFT most and RIGHT most) chooses the +15V supply from Backplane\nNEVER do both at the same time\n\nWhen DIR bit is low, current goes from + terminal to - terminal as indicated near the connector\n\nDate: 2026/08/13\nDeveloped By: Mike Hung"
		(at 188 70.5 0)
		(layer "B.SilkS")
		(uuid "e595ec99-6a2c-499a-b3a3-2ba13e7e5c1d")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left top mirror)
		)
	)
