	(gr_text "To only use the +15V from the Backplane:\nDisconnect the external +15V from the connector, then\nshort ONLY 1 AND 6\n\nOtherwise leave ALL four middle pins shorted, and\nDO NOT connect 1 AND 6"
		(at 108 53 0)
		(layer "F.SilkS")
		(uuid "f1f00ff3-12ee-45e7-a00b-f6b9cbab301f")
